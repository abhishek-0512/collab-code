# Collab Code — Environment Configuration Template

# Server Port and Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/collab-code?retryWrites=true&w=majority
MONGODB_URI=

# Authentication — JWT Secret and Expiration
JWT_SECRET=replace-with-a-secure-random-secret-in-production
JWT_EXPIRES_IN=7d

# Redis — Optional cache and multi-node adapter URL
REDIS_URL=redis://localhost:6379

# Code Execution Service — Piston or Judge0 API
PISTON_URL=https://emkc.org/api/v2/piston
